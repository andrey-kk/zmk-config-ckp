#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

#define DEFAULT 0
#define RAISE   1
#define LOWER   2

/* No rotary encoders are fitted on this board: disable the encoder and
 * keymap-sensor nodes that ZMK's in-tree bt60 board enables by default. */
&encoder_1 { status = "disabled"; };
&encoder_2 { status = "disabled"; };
&encoder_3 { status = "disabled"; };
&sensors   { status = "disabled"; };

/* Mod-tap keys (Right Shift/Up, Right Alt/Left, Menu/Down, Right Ctrl/Right):
 *  - tap            -> arrow key
 *  - hold (>200 ms) -> modifier
 *  - tap, then press and hold again within 175 ms -> arrow key auto-repeats */
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------
            // | ESC/` |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BKSP    |
            // | TAB    |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |    \     |
            // | CAPS    |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER     |
            // | SHIFT      |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |   SHIFT / UP    |
            // | CTRL  |  OPT  |  CMD  |            SPACE              | FN | OPT/LEFT | MENU/DOWN | CTRL/RIGHT |
            // ---------------------------------------------------------------------------------------------
            bindings = <
                &gresc    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LBKT  &kp RBKT  &kp BSLH
                &kp CLCK  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT             &kp RET
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH                     &mt RSHFT UP
                &kp LCTRL &kp LALT &kp LGUI           &kp SPACE                      &mo RAISE &mt RALT LEFT &mt K_CMENU DOWN &mt RCTRL RIGHT
            >;
        };

        raise {
            // Hold FN.
            // ---------------------------------------------------------------------------------------------
            // |  LOWER |  F1 |  F2 |  F3 |  F4 |  F5 |  F6 |  F7 |  F8 |  F9 | F10 | F11 | F12 |    DEL   |
            // |        |     |  UP |     |RGBTG|RGBFX|RGBHU|RGBB+| INS |RGBB-|PSCRN| SLCK|PAUSE| RESET    |
            // |         | LEFT| DOWN|RIGHT| PREV| PLAY| NEXT|BL_TG|BL - |BL + | HOME| PGUP|   BOOTLOADER  |
            // |            | PREV| NEXT| VOL-| VOL+| MUTE|     |     |     | END | PGDN|       UP        |
            // |       |       |       |                               |    |   LEFT   |   DOWN    |  RIGHT     |
            // ---------------------------------------------------------------------------------------------
            bindings = <
                &mo LOWER &kp F1     &kp F2     &kp F3       &kp F4          &kp F5           &kp F6          &kp F7        &kp F8      &kp F9      &kp F10       &kp F11   &kp F12         &kp DEL
                &trans    &trans     &kp UP     &trans       &rgb_ug RGB_TOG &rgb_ug RGB_EFF  &rgb_ug RGB_HUI &rgb_ug RGB_BRI &kp INS   &rgb_ug RGB_BRD &kp PSCRN &kp SLCK  &kp PAUSE_BREAK &sys_reset
                &trans    &kp LEFT   &kp DOWN   &kp RIGHT    &kp C_PREV      &kp C_PLAY_PAUSE &kp C_NEXT      &bl BL_TOG    &bl BL_DEC  &bl BL_INC  &kp HOME      &kp PG_UP                 &bootloader
                &trans    &kp C_PREV &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP    &kp C_MUTE       &trans          &trans        &trans      &kp END     &kp PG_DN                               &kp UP
                &trans    &trans     &trans                                  &trans                                                     &trans      &kp LEFT      &kp DOWN  &kp RIGHT
            >;
        };

        lower {
            // Hold FN, then hold ESC.
            // ---------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3 |  F4 |  F5 |  F6 |  F7 |  F8 |  F9 | F10 | F11 | F12 |    DEL    |
            // | BT 0   |     |  UP |     |BTCLR|     |     | USB | INS |     |PSCRN| SLCK|PAUSE| RESET    |
            // | BT 1    | LEFT| DOWN|RIGHT|     |     |     |     |     |     | HOME| PGUP|   BOOTLOADER  |
            // | BT 2       | VOL-| VOL+| MUTE|     | BLE |     |     |     | END | PGDN|                 |
            // | BT 3  |       |       |                               |    |  BT PREV | USB<->BLE |  BT NEXT   |
            // ---------------------------------------------------------------------------------------------
            bindings = <
                &trans       &kp F1       &kp F2       &kp F3     &kp F4     &kp F5      &kp F6 &kp F7      &kp F8  &kp F9  &kp F10   &kp F11    &kp F12         &kp DEL
                &bt BT_SEL 0 &trans       &kp UP       &trans     &bt BT_CLR &trans      &trans &out OUT_USB &kp INS &trans  &kp PSCRN &kp SLCK   &kp PAUSE_BREAK &sys_reset
                &bt BT_SEL 1 &kp LEFT     &kp DOWN     &kp RIGHT  &trans     &trans      &trans &trans      &trans  &trans  &kp HOME  &kp PG_UP                  &bootloader
                &bt BT_SEL 2 &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans     &out OUT_BLE &trans &trans     &trans  &kp END &kp PG_DN                              &trans
                &bt BT_SEL 3 &trans       &trans                             &trans                                         &trans    &bt BT_PRV &out OUT_TOG    &bt BT_NXT
            >;
        };
    };
};
